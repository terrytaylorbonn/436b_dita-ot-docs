<map>
  <title>@@@Intro topics111@@@@@@@@@@@@@</title>

  <!-- Key definitions for content reuse -->
  <keydef keys="product-name">
    <topicmeta>
      <linktext>###product-name111############</linktext>
    </topicmeta>
  </keydef>
  
  <keydef keys="version">
    <topicmeta>
      <linktext>###version111#############</linktext>
    </topicmeta>
  </keydef>
  
  <keydef keys="company">
    <topicmeta>
      <linktext>###company-name111########</linktext>
    </topicmeta>
  </keydef>

  <topicref keyref="release-notes">
    <topicref keyref="release-history" deliveryTarget="html"/>
  </topicref>
  <topicref keyref="input-formats" collection-type="family" linking="normal">
    <mapref href="input-formats.ditamap"/>
  </topicref>
  <topicref keyref="output-formats" linking="normal">
    <mapref href="transformations.ditamap"/>
  </topicref>
  <topicref href="my-custom-topic.dita" linking="normal"/>
  
  <!-- DITA Feature Demonstrations -->
  <topicgroup>
    <topicmeta>
      <navtitle>DITA Core Features</navtitle>
    </topicmeta>
    <topicref href="keys-demo.dita" linking="normal">
      <topicmeta>
        <navtitle>1. Content Reuse with Keys</navtitle>
      </topicmeta>
    </topicref>
  </topicgroup>
  
  <!-- AI can intelligently organize related topics -->
  <topicgroup>
    <topicmeta>
      <navtitle>Advanced Topics</navtitle>
    </topicmeta>
    <topicref href="ai-dita-management.dita" linking="normal">
      <topicmeta>
        <navtitle>AI-Driven DITA Management</navtitle>
      </topicmeta>
    </topicref>
    <topicref href="my-custom-topic.dita" linking="normal"/>
    <topicref keyref="plugin-development" collection-type="sequence">
      <topicref keyref="plugin-basics"/>
      <topicref keyref="plugin-advanced"/>
    </topicref>
    <topicref keyref="customization-topics" collection-type="family">
      <topicref keyref="css-customization"/>
      <topicref keyref="pdf-customization"/>
    </topicref>
  </topicgroup>

</map>
